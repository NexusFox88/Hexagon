{
  "name": "console-non-color",
  "version": "1.0.0",
  "format": "Custom flat token map; not DTCG interchange format.",
  "description": "Portable non-color design tokens: three font roles, square geometry, fine borders, flat hierarchy and optional character art.",
  "usage": {
    "defaultProfile": "console",
    "profiles": {
      "console": "Use tokens without the marketing. prefix by default.",
      "marketing": "marketing.* provides roomier presentation dimensions; opt in without overriding Console defaults."
    },
    "cssVariableNaming": "Replace dots with hyphens and prefix with --console-.",
    "colors": "Reuse the host semantic color system; no colors are defined here.",
    "fonts": "Generic font families only; the host loads font assets.",
    "precedence": "Host design, accessibility and localization requirements take precedence; resolve conflicts explicitly."
  },
  "recipes": {
    "pageTitle": {
      "fontFamily": "font.family.display",
      "typographyPrefix": "type.page"
    },
    "sectionTitle": {
      "fontFamily": "font.family.display",
      "typographyPrefix": "type.section"
    },
    "subsectionTitle": {
      "fontFamily": "font.family.body",
      "typographyPrefix": "type.subsection"
    },
    "bodyAndTable": {
      "fontFamily": "font.family.body",
      "typographyPrefix": "type.body"
    },
    "controlLabel": {
      "fontFamily": "font.family.body",
      "typographyPrefix": "type.label"
    },
    "metadata": {
      "fontFamily": "font.family.body",
      "typographyPrefix": "type.meta"
    },
    "codeAndIdentifiers": {
      "fontFamily": "font.family.mono",
      "typographyPrefix": "type.code"
    },
    "metric": {
      "fontFamily": "font.family.display",
      "typographyPrefix": "type.metric",
      "numericVariant": "number.variant"
    }
  },
  "rules": [
    "Use space.* for spacing and art.cell.* for character art; do not mix the grids.",
    "Treat control and table row heights as minimums to accommodate translation, wrapping and zoom.",
    "Use zero letter spacing for Chinese headings; do not force monospace for body text, status or long explanations.",
    "Use fluid table widths; marketing.layout.content-max does not constrain Console workspaces.",
    "Use square geometry, fine borders and flat hierarchy; reuse host behavior and semantics.",
    "Preserve keyboard controls, focus management and visible focus using host semantic tokens.",
    "Use text or icons alongside color for important states.",
    "Use an accessible mobile drawer, wrapping toolbars and local horizontal scrolling for tables and code.",
    "Use motion.fast for interactions and motion.standard for expansion; avoid transition: all.",
    "Disable unnecessary motion, parallax and flashing with prefers-reduced-motion; preserve understandable states.",
    "Reserve character art for empty states, onboarding and completion feedback using product-specific metaphors.",
    "Mark decorative art aria-hidden; provide DOM text for informative art and accessible controls for actions.",
    "Do not replace monitoring, permission notices or action icons with character art; pause hidden animations.",
    "Preserve business logic, permissions, user content and API identifiers; use complete localization catalogs."
  ],
