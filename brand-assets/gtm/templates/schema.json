{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["launch","feature","code","explainer","carousel","release"],
  "additionalProperties":false,
  "patternProperties":{
    "^(launch|feature|code|explainer|carousel|release)$":{
      "type":"object",
      "required":["headline","description","concept","kicker"],
      "additionalProperties":false,
      "properties":{
        "headline":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"string","minLength":1,"maxLength":38}},
        "description":{"type":"string","maxLength":100},
        "kicker":{"type":"string","maxLength":28},
        "concept":{"enum":["fleet","stack","control","isolation","continuity","wake","tools","delivery"]}
      }
    }
  }
}
